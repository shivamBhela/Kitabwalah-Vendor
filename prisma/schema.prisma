// Kitabwalah Vendor Platform · Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum VendorStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  NEW
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  COMPLETED
  REJECTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum SettlementStatus {
  PENDING
  SETTLED
}

enum SenderType {
  VENDOR
  SUPPORT
}

// ─── Vendor & Auth Models ─────────────────────────────────────────────────────

model Vendor {
  id           String       @id @default(uuid()) @db.Uuid
  phone        String?      @unique @db.VarChar(20)
  email        String?      @unique
  authProvider String       @map("auth_provider") @db.VarChar(20)
  status       VendorStatus @default(PENDING_REVIEW)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  profile             VendorProfile?
  store               Store?
  kycSubmissions      KycSubmission[]
  sessions            VendorSession[]
  notificationDevices NotificationDevice[]
  products            Product[]
  inventory           Inventory[]
  orders              Order[]
  shipments           Shipment[]
  returns             Return[]
  reviews             Review[]
  reviewResponses     ReviewResponse[]
  earnings            Earning[]
  settlements         Settlement[]
  withdrawals         Withdrawal[]
  notifications       Notification[]
  supportTickets      SupportTicket[]

  @@map("vendors")
}

model VendorProfile {
  vendorId        String    @id @map("vendor_id") @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_profiles")
}

model Store {
  id             String   @id @default(uuid()) @db.Uuid
  vendorId       String   @unique @map("vendor_id") @db.Uuid
  name           String   @db.VarChar(160)
  slug           String   @unique @db.VarChar(180)
  description    String?
  vacationMode   Boolean  @default(false) @map("vacation_mode")
  commissionRate Decimal  @default(12.00) @map("commission_rate") @db.Decimal(5, 2)
  rating         Decimal? @default(0) @db.Decimal(3, 2)
  followerCount  Int      @default(0) @map("follower_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  products Product[]
  orders   Order[]
  reviews  Review[]

  @@map("stores")
}

model KycSubmission {
  id            String       @id @default(uuid()) @db.Uuid
  vendorId      String       @map("vendor_id") @db.Uuid
  status        VendorStatus @default(PENDING_REVIEW)
  identityType  String?      @map("identity_type") @db.VarChar(30)
  identityLast4 String?      @map("identity_last4") @db.VarChar(4)
  documentUrls  Json         @default("[]") @map("document_urls")
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("kyc_submissions")
}

model VendorSession {
  id           String    @id @default(uuid()) @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  device       String    @db.VarChar(160)
  location     String?   @db.VarChar(160)
  tokenHash    String    @map("token_hash")
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_sessions")
}

model NotificationDevice {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  token     String
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, token])
  @@map("notification_devices")
}

// ─── Catalog & Inventory Models ───────────────────────────────────────────────

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  vendorId     String        @map("vendor_id") @db.Uuid
  storeId      String        @map("store_id") @db.Uuid
  name         String        @db.VarChar(240)
  description  String?
  category     String        @db.VarChar(100)
  subcategory  String?       @db.VarChar(100)
  sku          String        @db.VarChar(100)
  defaultPrice Decimal       @map("default_price") @db.Decimal(12, 2)
  status       ProductStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  store         Store          @relation(fields: [storeId], references: [id])
  images        ProductImage[]
  productPrices ProductPrice[]
  cityPrices    CityPrice[]
  inventory     Inventory?
  orderItems    OrderItem[]
  reviews       Review[]

  @@unique([vendorId, sku])
  @@index([vendorId, status, updatedAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductPrice {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  price     Decimal   @db.Decimal(12, 2)
  startsAt  DateTime? @map("starts_at") @db.Timestamptz
  endsAt    DateTime? @map("ends_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model CityPrice {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  city      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, city])
  @@map("city_prices")
}

model Inventory {
  productId         String   @id @map("product_id") @db.Uuid
  vendorId          String   @map("vendor_id") @db.Uuid
  availableStock    Int      @default(0) @map("available_stock")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([vendorId, availableStock])
  @@map("inventory")
}

// ─── Orders & Fulfilment Models ───────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  publicId        String      @unique @map("public_id") @db.VarChar(30)
  vendorId        String      @map("vendor_id") @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  customerName    String      @map("customer_name") @db.VarChar(120)
  customerPhone   String?     @map("customer_phone") @db.VarChar(25)
  deliveryAddress Json        @map("delivery_address")
  paymentStatus   String      @map("payment_status") @db.VarChar(20)
  status          OrderStatus @default(NEW)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  placedAt        DateTime    @default(now()) @map("placed_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])
  orderItems OrderItem[]
  shipment   Shipment?
  returns    Return[]
  earning    Earning?

  @@index([vendorId, status, placedAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(240)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  returns Return[]

  @@map("order_items")
}

model Shipment {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  shipmentCode String    @unique @map("shipment_code") @db.VarChar(60)
  courier      String?   @db.VarChar(80)
  pickupCode   String?   @map("pickup_code") @db.VarChar(40)
  status       String    @default("PREPARING") @db.VarChar(30)
  handoverAt   DateTime? @map("handover_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  order  Order  @relation(fields: [orderId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("shipments")
}

model Return {
  id                  String       @id @default(uuid()) @db.Uuid
  publicId            String       @unique @map("public_id") @db.VarChar(30)
  orderId             String       @map("order_id") @db.Uuid
  orderItemId         String?      @map("order_item_id") @db.Uuid
  vendorId            String       @map("vendor_id") @db.Uuid
  customerName        String       @map("customer_name") @db.VarChar(120)
  reason              String
  status              ReturnStatus @default(REQUESTED)
  reversePickupStatus String?      @map("reverse_pickup_status") @db.VarChar(40)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  order     Order      @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  vendor    Vendor     @relation(fields: [vendorId], references: [id])

  @@map("returns")
}

// ─── Reviews & Ratings Models ────────────────────────────────────────────────

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  vendorId     String   @map("vendor_id") @db.Uuid
  customerName String   @map("customer_name") @db.VarChar(120)
  rating       Int      @db.SmallInt
  body         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  product  Product         @relation(fields: [productId], references: [id])
  store    Store           @relation(fields: [storeId], references: [id])
  vendor   Vendor          @relation(fields: [vendorId], references: [id])
  response ReviewResponse?

  @@map("reviews")
}

model ReviewResponse {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @unique @map("review_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("review_responses")
}

// ─── Finance & Payout Models ─────────────────────────────────────────────────

model Earning {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @unique @map("order_id") @db.Uuid
  vendorId         String    @map("vendor_id") @db.Uuid
  grossAmount      Decimal   @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal   @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal   @map("net_amount") @db.Decimal(12, 2)
  availableAt      DateTime? @map("available_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order  Order  @relation(fields: [orderId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("earnings")
}

model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  publicId         String           @unique @map("public_id") @db.VarChar(30)
  vendorId         String           @map("vendor_id") @db.Uuid
  grossAmount      Decimal          @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal          @map("net_amount") @db.Decimal(12, 2)
  status           SettlementStatus @default(PENDING)
  settledAt        DateTime?        @map("settled_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("settlements")
}

model Withdrawal {
  id            String       @id @default(uuid()) @db.Uuid
  publicId      String       @unique @map("public_id") @db.VarChar(30)
  vendorId      String       @map("vendor_id") @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  paymentMethod String       @map("payment_method") @db.VarChar(20)
  accountMasked String       @map("account_masked") @db.VarChar(60)
  status        PayoutStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("withdrawals")
}

// ─── Notifications & Support Models ───────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  vendorId  String    @map("vendor_id") @db.Uuid
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  publicId    String   @unique @map("public_id") @db.VarChar(30)
  vendorId    String   @map("vendor_id") @db.Uuid
  category    String   @db.VarChar(60)
  subject     String   @db.VarChar(180)
  status      String   @default("OPEN") @db.VarChar(30)
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor           @relation(fields: [vendorId], references: [id])
  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id          String     @id @default(uuid()) @db.Uuid
  ticketId    String     @map("ticket_id") @db.Uuid
  senderType  SenderType @map("sender_type")
  body        String
  attachments Json       @default("[]")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}
